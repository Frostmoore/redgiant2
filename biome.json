{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!memory",
      "!**/*.tsbuildinfo",
      "!packages/web/public/zeta/zeta.js",
      "!**/test/fixtures/**/*.svg"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    },
    "domains": {
      "react": "none"
    }
  },
  "overrides": [
    {
      "includes": ["packages/protocol/src/artifact.ts"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
