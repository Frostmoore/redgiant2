#!/usr/bin/env bash
# RedGiant OS (G39.1): starts and stops RedGiant's compose stack (redgiant.service).
#   redgiant-stack up | down | images | status
# The images are the stack's (stack.json), pinned by digest: loaded from the copies built into the
# image the first time, otherwise pulled by digest; an image whose id is not the pinned one is
# never started.
set -euo pipefail
# shellcheck source=common.sh
. /usr/lib/redgiant-os/common.sh

secret() { LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c "${1:-40}" || true; }

# The settings with the keys, written once (0600, root only): the same .env the installer writes.
settings() {
  install -d -m 0700 "$STATE"
  install -d -m 0755 "$MEDIA"
  if [ ! -s "$STATE/stack.env" ]; then
    umask 077
    {
      echo "# RedGiant OS: written at the first start. Keep it private: it holds the access token."
      echo "REDGIANT_TOKEN=$(secret 40)"
      echo "POSTGRES_PASSWORD=$(secret 32)"
      # The page is for the local network: the OS has no other way in.
      echo "REDGIANT_BIND=0.0.0.0"
      echo "REDGIANT_PORT=$PORT"
    } >"$STATE/stack.env.new"
    mv "$STATE/stack.env.new" "$STATE/stack.env"
    log "settings written to $STATE/stack.env"
  fi
}

# The host's GPUs and the disk of Docker's data, as install.sh measures them for the server.
gpus() {
  local card vendor name vram slot
  for card in /sys/class/drm/card[0-9]; do
    [ -r "$card/device/vendor" ] || continue
    vendor=$(cat "$card/device/vendor")
    slot=$(basename "$(readlink -f "$card/device")")
    name=$(lspci -s "$slot" 2>/dev/null | sed 's/^[^:]*: *//; s/^[^:]*: *//' || true)
    case "$vendor" in 0x10de) name=${name:-NVIDIA GPU} ;; 0x1002) name=${name:-AMD Radeon GPU} ;; 0x8086) name=${name:-Intel GPU} ;; *) name=${name:-GPU} ;; esac
    vram=0
    [ -r "$card/device/mem_info_vram_total" ] && vram=$(awk '{ printf "%.1f", $1 / 1073741824 }' "$card/device/mem_info_vram_total")
    printf "%s:%s;" "${name//[:;]/ }" "$vram"
  done | sed 's/;$//'
}
disk() {
  local src dev rota tran free total
  src=$(findmnt -no SOURCE --target "$STATE" | head -1)
  dev=$(lsblk -no PKNAME "$src" 2>/dev/null | head -1)
  [ -n "$dev" ] || dev=$(basename "$src")
  rota=$(cat "/sys/block/$dev/queue/rotational" 2>/dev/null || echo "")
  tran=$(lsblk -dno TRAN "/dev/$dev" 2>/dev/null | head -1)
  case "$rota" in 0) rota=ssd ;; 1) rota=hdd ;; *) rota="?" ;; esac
  case "$dev" in nvme*) rota=ssd tran=${tran:-nvme} ;; esac
  free=$(df -BG --output=avail "$STATE" | tail -1 | tr -dc 0-9)
  total=$(df -BG --output=size "$STATE" | tail -1 | tr -dc 0-9)
  printf "/|%s|%s|%s.0|%s.0" "$rota" "${tran:-other}" "${free:-0}" "${total:-0}"
}

# The stack's files (compose.yaml and the rest) and the .env compose reads: settings, images,
# measured hardware. Written at every start, so an update's files take effect.
files() {
  local stack=$1 f
  install -d -m 0755 "$STACK_DIR" "$STACK_DIR/docker/searxng" "$STACK_DIR/windows-engine" "$STACK_DIR/no-win-mounts"
  for f in $(jq -r '.files | keys[]' "$stack"); do
    jq -r --arg f "$f" '.files[$f]' "$stack" >"$STACK_DIR/$f.new"
    mv "$STACK_DIR/$f.new" "$STACK_DIR/$f"
  done
  umask 077
  {
    cat "$STATE/stack.env"
    jq -r --arg a "$(arch)" '.images[$a][] | "\(.env)=\(.ref)"' "$stack"
    echo "REDGIANT_HOST_GPUS=$(gpus)"
    echo "REDGIANT_HOST_DISKS=$(disk)"
    if ls /dev/dri/renderD* >/dev/null 2>&1; then echo "REDGIANT_ENGINE_GPU=dri"; else echo "REDGIANT_ENGINE_GPU="; fi
  } >"$STACK_DIR/.env.new"
  mv "$STACK_DIR/.env.new" "$STACK_DIR/.env"
}

image_id() { docker image inspect --format '{{.Id}}' "$1" 2>/dev/null || true; }

# Every image of the stack present with its pinned id: from the built-in copies, else pulled.
images() {
  local stack=$1 ref digest id repo tar
  while IFS=$'\t' read -r ref digest id; do
    [ "$(image_id "$ref")" = "$id" ] && continue
    tar="$STATE/preload/$(echo "$ref" | tr '/:' '__').tar"
    if [ -r "$tar" ]; then
      log "loading $ref from the built-in copy"
      docker load -i "$tar" >/dev/null
    fi
    if [ "$(image_id "$ref")" != "$id" ]; then
      repo=${ref%:*}
      log "downloading $repo@$digest"
      docker pull -q "$repo@$digest" >/dev/null
      docker tag "$repo@$digest" "$ref"
    fi
    if [ "$(image_id "$ref")" != "$id" ]; then
      log "$ref is not the pinned image ($id): not started"
      return 1
    fi
    rm -f "$tar"
  done < <(jq -r --arg a "$(arch)" '.images[$a][] | [.ref, .digest, .id] | @tsv' "$stack")
}

case "${1:-}" in
  up)
    stack=$(current_stack)
    settings
    images "$stack"
    files "$stack"
    compose up -d --remove-orphans --pull never
    ;;
  down) compose down ;;
  images) images "$(current_stack)" ;;
  # The images of another stack (an update about to be applied), nothing started.
  images-of) images "$2" ;;
  status) compose ps ;;
  *)
    echo "usage: redgiant-stack up | down | images | status" >&2
    exit 2
    ;;
esac
