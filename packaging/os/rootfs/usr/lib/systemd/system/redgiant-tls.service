# The machine's local certificate authority and the certificate of https://redgiant.local,
# made at the first start; renewed when the addresses change or it is about to expire.
[Unit]
Description=RedGiant OS: local HTTPS certificate
After=network-online.target avahi-daemon.service
Wants=network-online.target
Before=caddy.service

[Service]
Type=oneshot
ExecStart=/usr/lib/redgiant-os/redgiant-tls ensure
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
