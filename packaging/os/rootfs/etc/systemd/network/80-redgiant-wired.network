# RedGiant OS: every wired network card asks for an address (DHCP and IPv6). A cable wins over
# Wi-Fi when both are there (lower route metric than 81-redgiant-wifi.network).
[Match]
Type=ether
Kind=!*

[Network]
DHCP=yes
IPv6AcceptRA=yes
MulticastDNS=no
LLMNR=no

[DHCPv4]
RouteMetric=100

[IPv6AcceptRA]
RouteMetric=100
