<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- RedGiant OS: the page, announced on the local network (redgiant.local). -->
<service-group>
  <name replace-wildcards="yes">RedGiant on %h</name>
  <service>
    <type>_http._tcp</type>
    <port>7600</port>
    <txt-record>path=/</txt-record>
  </service>
</service-group>
