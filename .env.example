# Written by the installer; edit and run `docker compose up -d` again.
REDGIANT_TOKEN=
POSTGRES_PASSWORD=
# Where the web UI listens (127.0.0.1 = this computer only; 0.0.0.0 = the network: put HTTPS in front).
REDGIANT_BIND=127.0.0.1
REDGIANT_PORT=7600

# Models (the setup wizard will ask for these)
ANTHROPIC_API_KEY=
REDGIANT_DEFAULT_MODEL=anthropic/claude-opus-5-5
# Local engine (profile "engine" or "engine-cuda"): a GGUF file in the redgiant-models volume
# REDGIANT_LLAMACPP_URL=http://engine:8080
# REDGIANT_ENGINE_MODEL=gemma-4-E2B_q4_0-it.gguf

# Telegram (optional): a bot token from @BotFather
# REDGIANT_TELEGRAM_TOKEN=

# Web search (profile "search")
# REDGIANT_SEARXNG_URL=http://searxng:8080
# SEARXNG_SECRET=
