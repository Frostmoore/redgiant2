+// RedGiant research (G26.6, 2026-11-04): TEAL-style activation sparsity, for measuring only.
+// With LLAMA_TEAL_C=c, the inputs of every layer's matrix product whose magnitude is below
+// c times the token's mean magnitude are set to zero (no speed gain: the weights are still read).
+static float redgiant_teal_c() {
+    static const float c = [] {
+        const char * e = getenv("LLAMA_TEAL_C");
+        return e ? (float) atof(e) : 0.0f;
+    }();
+    return c;
+}
