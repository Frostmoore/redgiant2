 ggml_tensor * llm_graph_context::build_lora_mm(
           ggml_tensor * w,
           ggml_tensor * cur,
           ggml_tensor * w_s) const {
+    if (redgiant_teal_c() > 0.0f && strncmp(w->name, "blk.", 4) == 0) {
+        ggml_tensor * x    = ggml_is_contiguous(cur) ? cur : ggml_cont(ctx0, cur);
+        ggml_tensor * mag  = ggml_abs(ctx0, x);
+        ggml_tensor * cut  = ggml_scale(ctx0, ggml_mean(ctx0, mag), redgiant_teal_c());
+        ggml_tensor * mask = ggml_step(ctx0, ggml_sub(ctx0, mag, cut));
+        ggml_set_name(mask, "teal_mask");
+        cur = ggml_mul(ctx0, x, mask);
+    }
     // a Hadamard-folded weight reads the transformed input; a LoRA delta lives in the primal basis and reads `cur`
     ggml_tensor * cur_mm = build_hadamard_input(w, cur);
     ggml_tensor * res = ggml_mul_mat(ctx0, w, cur_mm);
